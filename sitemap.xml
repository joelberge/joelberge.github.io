---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for path in site.data.sitemap_pages %}
  <url>
    <loc>{{ path | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <xhtml:link rel="alternate" hreflang="nb" href="{{ '/' | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ '/en/' | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ '/' | absolute_url }}"/>
  </url>
{%- endfor %}
</urlset>
